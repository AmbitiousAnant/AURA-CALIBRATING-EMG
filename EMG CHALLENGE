{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.13.16","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"competition","sourceId":166457}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"import os\nimport re\nimport glob\nimport random\nimport warnings\nfrom concurrent.futures import ThreadPoolExecutor\nimport numpy as np\nimport pandas as pd\nfrom scipy.signal import butter, filtfilt\n\nimport torch\nimport torch.nn as nn\nimport torch.nn.functional as F\nfrom torch.utils.data import Dataset, DataLoader\nfrom sklearn.model_selection import StratifiedGroupKFold\nfrom sklearn.preprocessing import RobustScaler\nfrom sklearn.metrics import f1_score, classification_report\nfrom lightgbm import LGBMClassifier, early_stopping\n\ntry:\n    from catboost import CatBoostClassifier\n    HAS_CATBOOST = True\nexcept ImportError:\n    HAS_CATBOOST = False\n\nwarnings.filterwarnings(\"ignore\")\n\n# =====================================================================\n# 0. CONFIGURATION & REPRODUCIBILITY\n# =====================================================================\ndef seed_everything(seed=42):\n    random.seed(seed)\n    os.environ['PYTHONHASHSEED'] = str(seed)\n    np.random.seed(seed)\n    torch.manual_seed(seed)\n    torch.cuda.manual_seed_all(seed)\n    torch.backends.cudnn.deterministic = True\n\nseed_everything(42)\nDEVICE = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\nprint(f\"Running V4 Anti-Center-Overfit & Pruned Ensemble Pipeline on: {DEVICE}\")\n\nEMG_COLS = [f'ch{i}' for i in range(1, 9)]\nIMU_COLS = ['ax', 'ay', 'az', 'gx', 'gy', 'gz']\nSIGNAL_COLS = EMG_COLS + IMU_COLS\n\n# Real optical/orientation columns present in Train (strictly masked when NaN, NEVER faked from y_cls)\nAUX_REG_COLS = [\n    'roll', 'pitch', 'yaw', 'index_curl', 'middle_curl',\n    'ring_curl', 'pinky_curl', 'pinch', 'openness', 'thumb_up'\n]\n\nGESTURES = ['rest', 'fist', 'open', 'point', 'pinch', 'thumb-up']\nGESTURE_MAP = {g: i for i, g in enumerate(GESTURES)}\nINV_GESTURE_MAP = {i: g for i, g in enumerate(GESTURES)}\n\nSEQ_LEN = 192\nWINDOW_SEC = 1.4\nBATCH_SIZE = 64\nEPOCHS = 38\nLR = 1.1e-3\nN_FOLDS = 5\n\nDATA_DIR = None\nfor root, dirs, files in os.walk('/kaggle/input'):\n    if any(f.startswith('train_') and f.endswith('.xlsx') for f in files):\n        DATA_DIR = os.path.dirname(root) if os.path.basename(root) == 'train' else root\n        break\nif DATA_DIR is None:\n    DATA_DIR = '/kaggle/input/competitions/vr-calibration-free-emg-challenge-pieeg'\n\ndef natural_key(path):\n    nums = re.findall(r'\\d+', os.path.basename(path))\n    return int(nums[0]) if nums else 0\n\ndef read_aura_excel_fast(fpath):\n    xl = pd.ExcelFile(fpath, engine='openpyxl')\n    sheet = 'multimodal' if 'multimodal' in xl.sheet_names else xl.sheet_names[0]\n    df = xl.parse(sheet)\n    df.columns = [str(c).replace('#', '').strip() for c in df.columns]\n    return fpath, df\n\n# =====================================================================\n# 1. V1 WAVEFORM FOUNDATION + PRE-NORMALIZATION BIOMECHANICAL FEATURES\n# =====================================================================\nB_HP, A_HP = butter(4, 15.0 / (250.0 / 2.0), btype='highpass')\n\ndef extract_v4_window_ representations(df_win, seq_len=SEQ_LEN):\n    \"\"\"\n    1. Preserves V1's exact row alignment & per-window Z-scored 44-channel tensor (which scored 0.53790 LB).\n    2. BEFORE Z-scoring, extracts 158 scale-aware & spatial-covariance biomechanical features\n       plus 8 real continuous muscle-synergy regression targets (100% leak-free!).\n    \"\"\"\n    raw = df_win[SIGNAL_COLS].astype(np.float32).values  # (T, 14)\n    raw = pd.DataFrame(raw).interpolate(method='linear', limit_direction='both').fillna(0.0).values\n    T = raw.shape[0]\n\n    # Step 1: Mean-center per 1.4s window (matches exact test format) + linear detrend\n    centered = raw - np.mean(raw, axis=0, keepdims=True)\n    if T > 4:\n        t_axis = np.linspace(-1.0, 1.0, T, dtype=np.float32)[:, None]\n        slope = np.sum(centered * t_axis, axis=0, keepdims=True) / (np.sum(t_axis ** 2) + 1e-8)\n        detrended = centered - slope * t_axis\n    else:\n        detrended = centered\n\n    # Step 2: First-order difference & Teager-Kaiser Energy Operator (TKEO)\n    delta = np.diff(detrended, axis=0, prepend=detrended[:1, :])\n    emg = detrended[:, :8]\n    emg_prev = np.roll(emg, 1, axis=0); emg_prev[0] = emg[0]\n    emg_next = np.roll(emg, -1, axis=0); emg_next[-1] = emg[-1]\n    tkeo = (emg ** 2) - (emg_prev * emg_next)\n\n    # Spatial EMG ratio at every time step\n    emg_abs = np.abs(delta[:, :8])\n    spatial_ratio = emg_abs / (np.sum(emg_abs, axis=1, keepdims=True) + 1e-5)\n\n    # --- PART A: Extract Tabular Biomechanics & Real Physical Regression Targets BEFORE Z-Scoring ---\n    # High-pass filtered EMG for clean amplitude & covariance calculation\n    if T > 18:\n        emg_hp = filtfilt(B_HP, A_HP, emg.astype(np.float64), axis=0).astype(np.float32)\n    else:\n        emg_hp = emg\n\n    imu = detrended[:, 8:]\n    feats = []\n\n    # 1. Pre-normalization Amplitudes (Crucial for separating 'rest' from active gestures!)\n    emg_rms = np.sqrt(np.mean(emg_hp ** 2, axis=0)) + 1e-5\n    emg_mav = np.mean(np.abs(emg_hp), axis=0) + 1e-5\n    emg_wl = np.mean(np.abs(np.diff(emg_hp, axis=0)), axis=0) + 1e-5\n    emg_p90 = np.percentile(np.abs(emg_hp), 90, axis=0) + 1e-5\n    emg_zc = np.sum(np.diff(np.sign(emg_hp), axis=0) != 0, axis=0) / float(T)\n\n    feats.extend(np.log1p(emg_rms))\n    feats.extend(np.log1p(emg_mav))\n    feats.extend(np.log1p(emg_wl))\n    feats.extend(np.log1p(emg_p90))\n    feats.extend(emg_zc)\n\n    # 2. User-Invariant Spatial Muscle Ratios (8 channels)\n    rms_prop = emg_rms / np.sum(emg_rms)\n    wl_prop = emg_wl / np.sum(emg_wl)\n    feats.extend(rms_prop)\n    feats.extend(wl_prop)\n\n    # Global energy & spatial concentration scalars\n    tot_log_rms = float(np.log1p(np.sum(emg_rms)))\n    tot_log_wl = float(np.log1p(np.sum(emg_wl)))\n    spatial_entropy = float(-np.sum(rms_prop * np.log(rms_prop + 1e-6)))\n    feats.extend([\n        tot_log_rms, tot_log_wl, spatial_entropy,\n        float(np.max(rms_prop)), float(np.std(rms_prop)), float(np.argmax(rms_prop))\n    ])\n\n    # 3. Antagonist Forearm Muscle Contrasts (Opposing & Adjacent Electrodes)\n    for i in range(8):\n        feats.append(float(rms_prop[i] - rms_prop[(i + 4) % 8]))\n        feats.append(float(rms_prop[i] - rms_prop[(i + 1) % 8]))\n\n    # 4. 8x8 Electrode Correlation & Log-Covariance Eigenvalues (36 features)\n    norm_e = emg_hp / (emg_rms[None, :] + 1e-5)\n    corr_mat = np.nan_to_num(np.corrcoef(norm_e.T), nan=0.0)\n    feats.extend(corr_mat[np.triu_indices(8, k=1)])\n    cov_mat = (norm_e.T @ norm_e) / float(T) + 1e-3 * np.eye(8)\n    eigvals = np.clip(np.linalg.eigvalsh(cov_mat), 1e-4, None)\n    feats.extend(np.log(eigvals))\n\n    # 5. Center-Invariant Temporal Distribution (Sorted Percentiles instead of fixed center slices!)\n    # Using temporal percentiles (25th, 50th, 75th, 95th) of the envelope makes features 100% immune\n    # to where inside the 1.4s window the user performed the gesture!\n    env_t = pd.DataFrame(np.abs(emg_hp)).rolling(window=max(3, T // 12), min_periods=1, center=True).mean().values\n    env_norm = env_t / (np.mean(env_t, axis=0, keepdims=True) + 1e-4)\n    feats.extend(np.percentile(env_norm, 90, axis=0))\n    feats.extend(np.percentile(env_norm, 50, axis=0))\n    feats.extend(np.percentile(env_norm, 90, axis=0) - np.percentile(env_norm, 20, axis=0))\n\n    # 6. FFT Frequency Band Ratios (16 features)\n    fft_mag = np.abs(np.fft.rfft(emg_hp, axis=0))\n    if len(fft_mag) > 6:\n        b_low, b_mid, b_high = np.array_split(fft_mag[1:], 3, axis=0)\n        p_low = np.mean(b_low, axis=0) + 1e-5\n        p_mid = np.mean(b_mid, axis=0) + 1e-5\n        p_high = np.mean(b_high, axis=0) + 1e-5\n        p_tot = p_low + p_mid + p_high\n        feats.extend(p_low / p_tot)\n        feats.extend(p_high / p_tot)\n    else:\n        feats.extend(np.zeros(16))\n\n    # 7. IMU 3D Kinematics (30 features)\n    imu_rms = np.sqrt(np.mean(imu ** 2, axis=0)) + 1e-5\n    imu_p90 = np.percentile(np.abs(imu), 90, axis=0)\n    imu_iqr = np.percentile(imu, 75, axis=0) - np.percentile(imu, 25, axis=0)\n    imu_net = np.mean(imu[T // 2:], axis=0) - np.mean(imu[:T // 2], axis=0)\n    feats.extend(np.log1p(imu_rms))\n    feats.extend(np.log1p(imu_p90))\n    feats.extend(np.log1p(np.abs(imu_iqr)))\n    feats.extend(imu_net)\n\n    acc_mag = np.sqrt(np.sum(imu[:, :3] ** 2, axis=1))\n    gyro_mag = np.sqrt(np.sum(imu[:, 3:] ** 2, axis=1))\n    feats.extend([\n        float(np.log1p(np.mean(acc_mag))), float(np.log1p(np.percentile(acc_mag, 90))),\n        float(np.log1p(np.mean(gyro_mag))), float(np.log1p(np.percentile(gyro_mag, 90))),\n        float(np.mean(acc_mag) / (np.mean(gyro_mag) + 1e-4)),\n        float(np.std(acc_mag)), float(np.std(gyro_mag))\n    ])\n\n    tab_vec = np.nan_to_num(np.array(feats, dtype=np.float32), nan=0.0, posinf=0.0, neginf=0.0)\n\n    # 8 Real Physical Synergy Targets (100% observed in every window, zero label leakage):\n    # [rms_prop (8), tot_log_rms (1), tot_log_wl (1), acc_log (1), gyro_log (1)] = 12 physical targets\n    phys_synergy_targets = np.concatenate([\n        rms_prop,\n        np.array([tot_log_rms, tot_log_wl, float(np.log1p(np.mean(acc_mag))), float(np.log1p(np.mean(gyro_mag)))], dtype=np.float32)\n    ])\n\n    # --- PART B: V1's Proven 44-Channel Per-Window Z-Scored Waveform Tensor ---\n    combined = np.concatenate([detrended, delta, tkeo, spatial_ratio], axis=1)  # (T, 44)\n    old_idx = np.linspace(0.0, 1.0, T)\n    new_idx = np.linspace(0.0, 1.0, seq_len)\n    resampled = np.zeros((seq_len, combined.shape[1]), dtype=np.float32)\n    for c in range(combined.shape[1]):\n        resampled[:, c] = np.interp(new_idx, old_idx, combined[:, c])\n\n    mean = np.mean(resampled, axis=0, keepdims=True)\n    std = np.std(resampled, axis=0, keepdims=True) + 1e-5\n    normed_seq = np.clip((resampled - mean) / std, -10.0, 10.0).T.astype(np.float32)  # (44, 192)\n\n    return normed_seq, tab_vec, phys_synergy_targets\n\n# =====================================================================\n# 2. ANTI-CENTER-OVERFITTING WINDOW SLICER & PARALLEL LOADER\n# =====================================================================\ndef load_v4_datasets(data_dir):\n    train_files = sorted(glob.glob(os.path.join(data_dir, \"**\", \"train_*.xlsx\"), recursive=True), key=natural_key)\n    test_files = sorted(glob.glob(os.path.join(data_dir, \"**\", \"test_*.xlsx\"), recursive=True), key=natural_key)\n    print(f\"Loading {len(train_files)} train files and {len(test_files)} test files in parallel...\")\n\n    with ThreadPoolExecutor(max_workers=4) as ex:\n        train_loaded = list(ex.map(read_aura_excel_fast, train_files))\n        test_loaded = list(ex.map(read_aura_excel_fast, test_files))\n\n    X_seq, X_tab, y_cls, y_opt_reg, opt_mask, y_phys_reg, groups, is_val_anchor = [], [], [], [], [], [], [], []\n\n    rng = np.random.RandomState(42)\n\n    for session_idx, (fpath, df) in enumerate(train_loaded):\n        if 'label_source' in df.columns:\n            df = df[df['label_source'].astype(str).str.strip().str.lower() == 'guided'].reset_index(drop=True)\n\n        label_col = 'label' if 'label' in df.columns else 'gesture'\n        df[label_col] = df[label_col].astype(str).str.strip().str.lower()\n        df = df[df[label_col].isin(GESTURE_MAP.keys())].reset_index(drop=True)\n        if len(df) == 0:\n            continue\n\n        time_jump = df['t'].diff().abs() > 0.25\n        label_change = df[label_col] != df[label_col].shift()\n        df['seg_id'] = (time_jump | label_change).cumsum()\n\n        for _, seg in df.groupby('seg_id'):\n            t_start, t_end = seg['t'].iloc[0], seg['t'].iloc[-1]\n            dur = t_end - t_start\n            gesture_id = GESTURE_MAP[seg[label_col].iloc[0]]\n\n            # 1. Clean Non-Overlapping Windows starting at t_start (Used for honest Validation & Base Train)\n            curr_t = t_start\n            while curr_t + WINDOW_SEC <= t_end + 0.06:\n                win = seg[(seg['t'] >= curr_t) & (seg['t'] < curr_t + WINDOW_SEC)]\n                if len(win) >= 35:\n                    s_t, t_v, p_r = extract_v4_window_representations(win, seq_len=SEQ_LEN)\n                    r_t = np.zeros(len(AUX_REG_COLS), dtype=np.float32)\n                    r_m = np.zeros(len(AUX_REG_COLS), dtype=np.float32)\n                    for idx, col in enumerate(AUX_REG_COLS):\n                        if col in win.columns:\n                            vals = pd.to_numeric(win[col], errors='coerce').dropna().values\n                            if len(vals) > 0:\n                                r_t[idx] = float(np.mean(vals))\n                                r_m[idx] = 1.0\n\n                    X_seq.append(s_t); X_tab.append(t_v); y_cls.append(gesture_id)\n                    y_opt_reg.append(r_t); opt_mask.append(r_m); y_phys_reg.append(p_r)\n                    groups.append(session_idx)\n                    is_val_anchor.append(1)  # Pure non-overlapping window!\n                curr_t += WINDOW_SEC * 0.85  # Slight step so we don't miss segment tails\n\n            # 2. Randomized Off-Center Windows (Prevents Center Memorization during Training!)\n            # Instead of a fixed grid that centers every gesture identically, we sample random off-center start times!\n            if dur > WINDOW_SEC + 0.25:\n                n_rand_crops = max(1, int((dur - WINDOW_SEC) / 0.55))\n                for _ in range(n_rand_crops):\n                    rand_t = rng.uniform(t_start, t_end - WINDOW_SEC)\n                    win = seg[(seg['t'] >= rand_t) & (seg['t'] < rand_t + WINDOW_SEC)]\n                    if len(win) >= 35:\n                        s_t, t_v, p_r = extract_v4_window_representations(win, seq_len=SEQ_LEN)\n                        r_t = np.zeros(len(AUX_REG_COLS), dtype=np.float32)\n                        r_m = np.zeros(len(AUX_REG_COLS), dtype=np.float32)\n                        for idx, col in enumerate(AUX_REG_COLS):\n                            if col in win.columns:\n                                vals = pd.to_numeric(win[col], errors='coerce').dropna().values\n                                if len(vals) > 0:\n                                    r_t[idx] = float(np.mean(vals))\n                                    r_m[idx] = 1.0\n\n                        X_seq.append(s_t); X_tab.append(t_v); y_cls.append(gesture_id)\n                        y_opt_reg.append(r_t); opt_mask.append(r_m); y_phys_reg.append(p_r)\n                        groups.append(session_idx)\n                        is_val_anchor.append(0)  # Off-center training augmentation window\n\n    X_seq = np.stack(X_seq)\n    X_tab = np.stack(X_tab)\n    y_cls = np.array(y_cls, dtype=np.int64)\n    y_opt_reg = np.stack(y_opt_reg)\n    opt_mask = np.stack(opt_mask)\n    y_phys_reg = np.stack(y_phys_reg)\n    groups = np.array(groups, dtype=np.int64)\n    is_val_anchor = np.array(is_val_anchor, dtype=np.int64)\n\n    # Normalize real optical targets where observed\n    for j in range(y_opt_reg.shape[1]):\n        valid = opt_mask[:, j] > 0.5\n        if np.sum(valid) > 10:\n            mu = np.mean(y_opt_reg[valid, j])\n            sd = np.std(y_opt_reg[valid, j]) + 1e-5\n            y_opt_reg[valid, j] = np.clip((y_opt_reg[valid, j] - mu) / sd, -4.0, 4.0)\n\n    # Normalize real physical synergy targets (100% dense, zero leakage)\n    phys_mu = np.mean(y_phys_reg, axis=0, keepdims=True)\n    phys_sd = np.std(y_phys_reg, axis=0, keepdims=True) + 1e-5\n    y_phys_reg = np.clip((y_phys_reg - phys_mu) / phys_sd, -4.0, 4.0)\n\n    # Combine into 22-D Regression Target: [10 Optical (masked) + 12 Physical Synergy (100% active)]\n    y_reg_all = np.hstack([y_opt_reg, y_phys_reg])\n    reg_mask_all = np.hstack([opt_mask, np.ones_like(y_phys_reg)])\n\n    # Load Test Set\n    X_test_seq, X_test_tab, test_ids = [], [], []\n    for fpath, df in test_loaded:\n        id_col = 'action_id' if 'action_id' in df.columns else df.columns[0]\n        for act_id, win in df.groupby(id_col, sort=False):\n            s_t, t_v, _ = extract_v4_window_representations(win, seq_len=SEQ_LEN)\n            X_test_seq.append(s_t)\n            X_test_tab.append(t_v)\n            test_ids.append(act_id)\n\n    X_test_seq = np.stack(X_test_seq)\n    X_test_tab = np.stack(X_test_tab)\n\n    print(f\"Total Windows: {len(X_seq)} (Clean Anchors: {np.sum(is_val_anchor)}) | Seq: {X_seq.shape} | Tab: {X_tab.shape}\")\n    print(f\"Test Actions:  {len(X_test_seq)}\")\n    return X_seq, X_tab, y_cls, y_reg_all, reg_mask_all, groups, is_val_anchor, X_test_seq, X_test_tab, test_ids\n\n# =====================================================================\n# 3. ANTI-CENTER-OVERFITTING DATASET & CASCADED V4 HYBRID NETWORK\n# =====================================================================\nclass AuraV4Dataset(Dataset):\n    def __init__(self, X_seq, X_tab, y_cls=None, y_reg=None, reg_mask=None, is_train=True):\n        self.X_seq = X_seq\n        self.X_tab = X_tab\n        self.y_cls = y_cls\n        self.y_reg = y_reg\n        self.reg_mask = reg_mask\n        self.is_train = is_train\n\n    def __len__(self):\n        return len(self.X_seq)\n\n    def __getitem__(self, idx):\n        x = self.X_seq[idx].copy()      # (44, 192)\n        tab = self.X_tab[idx].copy()\n\n        if self.is_train:\n            C, T = x.shape\n            # 1. Random Off-Center Sub-Window Zoom & Shift (Prevents Center Memorization without wrap-around spikes!)\n            if random.random() < 0.70:\n                crop_len = random.randint(int(T * 0.80), int(T * 0.96))\n                start_idx = random.randint(0, T - crop_len)\n                sub_x = x[:, start_idx : start_idx + crop_len]\n                # Re-center using the off-center sub-window mean so model never overfits to static center!\n                sub_x = sub_x - np.mean(sub_x, axis=-1, keepdims=True)\n                old_t = np.linspace(0.0, 1.0, crop_len)\n                new_t = np.linspace(0.0, 1.0, T)\n                for c in range(C):\n                    x[c, :] = np.interp(new_t, old_t, sub_x[c, :])\n\n            # 2. Random Temporal Cutout (Masks a random 10% time slice so model cannot rely on just the center!)\n            if random.random() < 0.35:\n                cut_len = random.randint(10, 22)\n                cut_start = random.randint(0, T - cut_len)\n                x[:, cut_start : cut_start + cut_len] = 0.0\n\n            # 3. Electrode Dropout (12% chance) & Amplitude Jitter\n            if random.random() < 0.12:\n                bad_ch = random.randint(0, 7)\n                x[bad_ch, :] = 0.0\n                x[14 + bad_ch, :] = 0.0\n                x[28 + bad_ch, :] = 0.0\n                x[36 + bad_ch, :] = 0.0\n\n            if random.random() < 0.45:\n                scale = np.random.uniform(0.88, 1.12, size=(C, 1)).astype(np.float32)\n                noise = np.random.normal(0.0, 0.025, size=x.shape).astype(np.float32)\n                x = x * scale + noise\n\n        if self.y_cls is None:\n            return torch.tensor(x, dtype=torch.float32), torch.tensor(tab, dtype=torch.float32)\n\n        return (\n            torch.tensor(x, dtype=torch.float32),\n            torch.tensor(tab, dtype=torch.float32),\n            torch.tensor(self.y_cls[idx], dtype=torch.long),\n            torch.tensor(self.y_reg[idx], dtype=torch.float32),\n            torch.tensor(self.reg_mask[idx], dtype=torch.float32)\n        )\n\nclass SEBlock1D(nn.Module):\n    def __init__(self, channels, reduction=4):\n        super().__init__()\n        self.fc = nn.Sequential(\n            nn.Linear(channels, channels // reduction),\n            nn.GELU(),\n            nn.Linear(channels // reduction, channels),\n            nn.Sigmoid()\n        )\n    def forward(self, x):\n        w = self.fc(x.mean(dim=-1)).unsqueeze(-1)\n        return x * w\n\nclass AuraHybridNetV4(nn.Module):\n    \"\"\"\n    Upgraded from V1's proven 0.53790 backbone:\n      - Keeps V1's InstanceNorm1d + Multi-Scale Conv1D + Transformer sequence encoder.\n      - Replaces fixed positional overfitting with Shift-Invariant Relative Convolution + Multi-Query Attention.\n      - Connects CNN + Pre-Norm Tabular Biomechanics -> 22-D Physics Regression Bottleneck -> Gesture Classifier!\n    \"\"\"\n    def __init__(self, in_channels=44, tab_dim=158, d_model=128, num_classes=6, num_reg=22):\n        super().__init__()\n        self.inst_norm = nn.InstanceNorm1d(in_channels, affine=True)\n\n        # Multi-Scale 1D-CNN Stem (Identical to V1's strong foundation)\n        self.conv_k3 = nn.Conv1d(in_channels, d_model // 2, kernel_size=3, padding=1)\n        self.conv_k7 = nn.Conv1d(in_channels, d_model // 4, kernel_size=7, padding=3)\n        self.conv_k15 = nn.Conv1d(in_channels, d_model // 4, kernel_size=15, padding=7)\n\n        self.cnn_encoder = nn.Sequential(\n            nn.BatchNorm1d(d_model),\n            nn.GELU(),\n            SEBlock1D(d_model),\n            nn.Dropout(0.15),\n            nn.MaxPool1d(kernel_size=2, stride=2),  # 192 -> 96\n            nn.Conv1d(d_model, d_model, kernel_size=5, padding=2),\n            nn.BatchNorm1d(d_model),\n            nn.GELU(),\n            SEBlock1D(d_model),\n            nn.MaxPool1d(kernel_size=2, stride=2)   # 96 -> 48 tokens\n        )\n\n        # Position-Invariant Depthwise Conv Pos Encoding (Never memorizes center index!)\n        self.rel_pos_conv = nn.Conv1d(d_model, d_model, kernel_size=5, padding=2, groups=d_model)\n\n        enc_layer = nn.TransformerEncoderLayer(\n            d_model=d_model, nhead=4, dim_feedforward=d_model * 2,\n            dropout=0.20, activation='gelu', batch_first=True, norm_first=True\n        )\n        self.transformer = nn.TransformerEncoder(enc_layer, num_layers=2)\n\n        # Temporal Attention Pooling\n        self.attn_pool = nn.Sequential(\n            nn.Linear(d_model, d_model // 2),\n            nn.Tanh(),\n            nn.Linear(d_model // 2, 1)\n        )\n\n        # Pre-Normalization Biomechanical Feature Branch (Restores 'rest' amplitude & 8x8 Electrode Covariance)\n        self.tab_branch = nn.Sequential(\n            nn.LayerNorm(tab_dim),\n            nn.Dropout(0.20),\n            nn.Linear(tab_dim, 96),\n            nn.GELU(),\n            nn.Dropout(0.20),\n            nn.Linear(96, 64),\n            nn.GELU()\n        )\n\n        # Fused Backbone Dimension = 128 (Attn) + 128 (Max) + 64 (Tab) = 320\n        fused_dim = d_model * 2 + 64\n\n        # Stage 1 Bottleneck: Predict 22-D Biomechanical & Optical Regression Targets\n        self.reg_bottleneck = nn.Sequential(\n            nn.LayerNorm(fused_dim),\n            nn.Dropout(0.20),\n            nn.Linear(fused_dim, 64),\n            nn.GELU(),\n            nn.Linear(64, num_reg)\n        )\n\n        # Stage 2 Classifier: Explicitly receives [Fused Features (320) + Regressed Kinematics (22) = 342]\n        self.cls_head = nn.Sequential(\n            nn.LayerNorm(fused_dim + num_reg),\n            nn.Dropout(0.30),\n            nn.Linear(fused_dim + num_reg, 96),\n            nn.GELU(),\n            nn.Dropout(0.15),\n            nn.Linear(96, num_classes)\n        )\n\n    def forward(self, x_seq, x_tab):\n        x = self.inst_norm(x_seq)\n        x = torch.cat([self.conv_k3(x), self.conv_k7(x), self.conv_k15(x)], dim=1)\n        x = self.cnn_encoder(x)                       # (B, 128, 48)\n        x = x + self.rel_pos_conv(x)                  # Shift-invariant relative position context\n\n        seq = self.transformer(x.permute(0, 2, 1))    # (B, 48, 128)\n        attn_w = F.softmax(self.attn_pool(seq), dim=1)\n        attn_pooled = torch.sum(seq * attn_w, dim=1)\n        max_pooled = torch.max(seq, dim=1)[0]\n\n        tab_feat = self.tab_branch(x_tab)             # (B, 64)\n        fused = torch.cat([attn_pooled, max_pooled, tab_feat], dim=-1)  # (B, 320)\n\n        # Cascaded Regression -> Classification\n        reg_preds = self.reg_bottleneck(fused)        # (B, 22)\n        logits = self.cls_head(torch.cat([fused, reg_preds], dim=-1))\n        return logits, reg_preds\n\nclass AuraV4Loss(nn.Module):\n    def __init__(self, num_classes=6, smoothing=0.06, gamma=2.0, f1_weight=0.35, reg_weight=0.30):\n        super().__init__()\n        self.num_classes = num_classes\n        self.smoothing = smoothing\n        self.gamma = gamma\n        self.f1_weight = f1_weight\n        self.reg_weight = reg_weight\n\n    def forward(self, logits, targets_cls, preds_reg, targets_reg, reg_mask):\n        probs = F.softmax(logits, dim=-1)\n        log_probs = F.log_softmax(logits, dim=-1)\n\n        with torch.no_grad():\n            true_dist = torch.full_like(log_probs, self.smoothing / (self.num_classes - 1))\n            true_dist.scatter_(1, targets_cls.unsqueeze(1), 1.0 - self.smoothing)\n\n        focal_weight = (1.0 - probs) ** self.gamma\n        focal_loss = torch.mean(torch.sum(-true_dist * focal_weight * log_probs, dim=-1))\n\n        one_hot = F.one_hot(targets_cls, num_classes=self.num_classes).float()\n        tp = torch.sum(probs * one_hot, dim=0)\n        fp = torch.sum(probs * (1.0 - one_hot), dim=0)\n        fn = torch.sum((1.0 - probs) * one_hot, dim=0)\n        soft_f1 = (2.0 * tp + 1e-5) / (2.0 * tp + fp + fn + 1e-5)\n        macro_f1_loss = 1.0 - torch.mean(soft_f1)\n\n        cls_loss = (1.0 - self.f1_weight) * focal_loss + self.f1_weight * macro_f1_loss\n\n        reg_l1 = F.smooth_l1_loss(preds_reg, targets_reg, reduction='none')\n        masked_reg = torch.sum(reg_l1 * reg_mask) / (torch.sum(reg_mask) + 1e-5)\n\n        return cls_loss + self.reg_weight * masked_reg\n\ndef predict_v4_tta(model, loader, device):\n    \"\"\"\n    Pure model.eval() TTA using off-center sub-window crops (left-biased, center, right-biased)\n    so test gestures at the start or end of a 1.4s window are captured cleanly without wrap-around spikes!\n    \"\"\"\n    model.eval()\n    all_probs = []\n    with torch.no_grad():\n        for batch in loader:\n            bx_seq = batch[0].to(device)\n            bx_tab = batch[1].to(device)\n            T = bx_seq.shape[-1]\n\n            # View 1: Full 1.4s window\n            l0, _ = model(bx_seq, bx_tab)\n\n            # View 2: Left-biased 88% crop interpolated back to T\n            left_crop = F.interpolate(bx_seq[:, :, :int(T * 0.88)], size=T, mode='linear', align_corners=False)\n            l_left, _ = model(left_crop, bx_tab)\n\n            # View 3: Right-biased 88% crop interpolated back to T\n            right_crop = F.interpolate(bx_seq[:, :, int(T * 0.12):], size=T, mode='linear', align_corners=False)\n            l_right, _ = model(right_crop, bx_tab)\n\n            probs = (\n                0.50 * F.softmax(l0, dim=-1) +\n                0.25 * F.softmax(l_left, dim=-1) +\n                0.25 * F.softmax(l_right, dim=-1)\n            )\n            all_probs.append(probs.cpu().numpy())\n    return np.concatenate(all_probs, axis=0)\n\n# =====================================================================\n# 4. 5-FOLD TRAINING + INDEPENDENT TREE PRUNING & ENSEMBLING\n# =====================================================================\n(X_seq, X_tab, y_cls, y_reg, reg_mask, groups, is_val_anchor,\n X_test_seq, X_test_tab, test_ids) = load_v4_datasets(DATA_DIR)\n\nsgkf = StratifiedGroupKFold(n_splits=N_FOLDS)\n\noof_nn = np.zeros((len(X_seq), 6), dtype=np.float32)\noof_lgb = np.zeros((len(X_seq), 6), dtype=np.float32)\noof_cat = np.zeros((len(X_seq), 6), dtype=np.float32)\n\ntest_nn = np.zeros((len(X_test_seq), 6), dtype=np.float32)\ntest_lgb = np.zeros((len(X_test_seq), 6), dtype=np.float32)\ntest_cat = np.zeros((len(X_test_seq), 6), dtype=np.float32)\n\ncriterion = AuraV4Loss()\n\nfor fold, (trn_idx, val_idx) in enumerate(sgkf.split(X_seq, y_cls, groups)):\n    print(f\"\\n==================== FOLD {fold + 1} / {N_FOLDS} ====================\")\n    # Strictly evaluate validation on non-overlapping anchor windows to prevent center/overlap inflation\n    clean_val_idx = val_idx[is_val_anchor[val_idx] == 1]\n\n    scaler = RobustScaler()\n    X_tab_trn = np.clip(scaler.fit_transform(X_tab[trn_idx]), -10.0, 10.0)\n    X_tab_val_all = np.clip(scaler.transform(X_tab[val_idx]), -10.0, 10.0)\n    X_tab_val_clean = np.clip(scaler.transform(X_tab[clean_val_idx]), -10.0, 10.0)\n    X_tab_tst = np.clip(scaler.transform(X_test_tab), -10.0, 10.0)\n\n    # --- STEP A: Automated Feature Pruning & Structural Tree Pruning (Independent of NN!) ---\n    scout_lgb = LGBMClassifier(\n        n_estimators=250, learning_rate=0.04, max_depth=4, num_leaves=15,\n        min_child_samples=40, subsample=0.75, colsample_bytree=0.6,\n        reg_alpha=3.0, reg_lambda=5.0, random_state=42 + fold, n_jobs=-1, verbose=-1\n    )\n    scout_lgb.fit(X_tab_trn, y_cls[trn_idx])\n\n    # Prune bottom 30% noisy/collinear features -> keep top 70% highest-signal biomechanical features\n    importances = scout_lgb.feature_importances_\n    k_keep = int(X_tab.shape[1] * 0.70)\n    keep_cols = np.argsort(importances)[::-1][:k_keep]\n\n    # Pruned LightGBM (Shallow depth=5, min_split_gain=0.02 cost-complexity pruning, early stopping tree truncation)\n    lgb_pruned = LGBMClassifier(\n        n_estimators=1200,\n        learning_rate=0.025,\n        max_depth=5,\n        num_leaves=20,\n        min_child_samples=35,\n        min_split_gain=0.02,   # Cost-complexity split pruning\n        subsample=0.80,\n        subsample_freq=1,\n        colsample_bytree=0.65,\n        reg_alpha=2.5,\n        reg_lambda=5.0,\n        random_state=100 + fold,\n        n_jobs=-1,\n        verbose=-1\n    )\n    lgb_pruned.fit(\n        X_tab_trn[:, keep_cols], y_cls[trn_idx],\n        eval_set=[(X_tab_val_clean[:, keep_cols], y_cls[clean_val_idx])],\n        callbacks=[early_stopping(80, verbose=False)]\n    )\n    oof_lgb[val_idx] = lgb_pruned.predict_proba(X_tab_val_all[:, keep_cols])\n    test_lgb += lgb_pruned.predict_proba(X_tab_tst[:, keep_cols]) / N_FOLDS\n    lgb_f1 = f1_score(y_cls[clean_val_idx], np.argmax(oof_lgb[clean_val_idx], axis=1), average='macro')\n\n    # Pruned CatBoost on Pruned Feature Subset\n    if HAS_CATBOOST:\n        cat_pruned = CatBoostClassifier(\n            iterations=1200,\n            learning_rate=0.035,\n            depth=5,\n            l2_leaf_reg=7.0,\n            random_strength=1.5,\n            random_seed=100 + fold,\n            task_type='CPU',\n            verbose=False\n        )\n        cat_pruned.fit(\n            X_tab_trn[:, keep_cols], y_cls[trn_idx],\n            eval_set=(X_tab_val_clean[:, keep_cols], y_cls[clean_val_idx]),\n            early_stopping_rounds=80, verbose=False\n        )\n        oof_cat[val_idx] = cat_pruned.predict_proba(X_tab_val_all[:, keep_cols])\n        test_cat += cat_pruned.predict_proba(X_tab_tst[:, keep_cols]) / N_FOLDS\n        cat_f1 = f1_score(y_cls[clean_val_idx], np.argmax(oof_cat[clean_val_idx], axis=1), average='macro')\n    else:\n        oof_cat[val_idx] = oof_lgb[val_idx]\n        test_cat += test_lgb / N_FOLDS\n        cat_f1 = lgb_f1\n\n    print(f\"  [Pruned Trees] Kept {k_keep}/{X_tab.shape[1]} feats | LGBM Clean Val F1: {lgb_f1:.4f} | CatBoost Clean Val F1: {cat_f1:.4f}\")\n\n    # --- STEP B: Train AuraHybridNetV4 with Anti-Center-Overfitting Cropping ---\n    trn_ds = AuraV4Dataset(X_seq[trn_idx], X_tab_trn, y_cls[trn_idx], y_reg[trn_idx], reg_mask[trn_idx], is_train=True)\n    val_ds_all = AuraV4Dataset(X_seq[val_idx], X_tab_val_all, is_train=False)\n    tst_ds = AuraV4Dataset(X_test_seq, X_tab_tst, is_train=False)\n\n    trn_loader = DataLoader(trn_ds, batch_size=BATCH_SIZE, shuffle=True, drop_last=True)\n    val_loader_all = DataLoader(val_ds_all, batch_size=BATCH_SIZE, shuffle=False)\n    tst_loader = DataLoader(tst_ds, batch_size=BATCH_SIZE, shuffle=False)\n\n    model = AuraHybridNetV4(\n        in_channels=X_seq.shape[1], tab_dim=X_tab.shape[1],\n        d_model=128, num_classes=6, num_reg=y_reg.shape[1]\n    ).to(DEVICE)\n\n    optimizer = torch.optim.AdamW(model.parameters(), lr=LR, weight_decay=1.5e-2)\n    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=EPOCHS, eta_min=1e-5)\n\n    best_nn_f1 = 0.0\n    best_val_probs = None\n    ckpt_path = f\"aura_v4_hybrid_fold{fold}.pt\"\n    anchor_submask = (is_val_anchor[val_idx] == 1)\n\n    for epoch in range(1, EPOCHS + 1):\n        model.train()\n        for bx_s, bx_t, by_c, by_r, bm in trn_loader:\n            bx_s, bx_t = bx_s.to(DEVICE), bx_t.to(DEVICE)\n            by_c, by_r, bm = by_c.to(DEVICE), by_r.to(DEVICE), bm.to(DEVICE)\n\n            optimizer.zero_grad()\n            logits, reg_p = model(bx_s, bx_t)\n            loss = criterion(logits, by_c, reg_p, by_r, bm)\n            loss.backward()\n            torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)\n            optimizer.step()\n\n        scheduler.step()\n\n        val_probs = predict_v4_tta(model, val_loader_all, DEVICE)\n        # Select checkpoint strictly by clean non-overlapping anchor F1\n        clean_f1 = f1_score(y_cls[val_idx][anchor_submask], np.argmax(val_probs[anchor_submask], axis=1), average='macro')\n\n        if clean_f1 > best_nn_f1:\n            best_nn_f1 = clean_f1\n            best_val_probs = val_probs\n            torch.save(model.state_dict(), ckpt_path)\n\n        if epoch % 10 == 0 or epoch == EPOCHS:\n            print(f\"  [HybridNetV4] Epoch {epoch:02d}/{EPOCHS:02d} | Clean Anchor Val F1: {clean_f1:.4f} (Best: {best_nn_f1:.4f})\")\n\n    oof_nn[val_idx] = best_val_probs\n\n    # Pure model.eval() Test Inference (NO AdaBN corruption!)\n    model.load_state_dict(torch.load(ckpt_path, map_location=DEVICE))\n    test_nn += predict_v4_tta(model, tst_loader, DEVICE) / N_FOLDS\n\n# =====================================================================\n# 5. POST-ENSEMBLE PRUNING, WEIGHT OPTIMIZATION & SANITY CHECKS\n# =====================================================================\nclean_mask = (is_val_anchor == 1)\ny_clean = y_cls[clean_mask]\n\nnn_clean_f1 = f1_score(y_clean, np.argmax(oof_nn[clean_mask], axis=1), average='macro')\nlgb_clean_f1 = f1_score(y_clean, np.argmax(oof_lgb[clean_mask], axis=1), average='macro')\ncat_clean_f1 = f1_score(y_clean, np.argmax(oof_cat[clean_mask], axis=1), average='macro')\n\n# Grid-search optimal ensemble weights (Automatically prunes any weak branch to 0.0 if unhelpful)\nbest_ens_f1 = 0.0\nbest_weights = (1.0, 0.0, 0.0)\n\nfor w_nn in np.linspace(0.20, 1.0, 17):\n    for w_lgb in np.linspace(0.0, 1.0 - w_nn, 17):\n        w_cat = max(0.0, 1.0 - w_nn - w_lgb)\n        blend = w_nn * oof_nn[clean_mask] + w_lgb * oof_lgb[clean_mask] + w_cat * oof_cat[clean_mask]\n        score = f1_score(y_clean, np.argmax(blend, axis=1), average='macro')\n        if score > best_ens_f1:\n            best_ens_f1 = score\n            best_weights = (w_nn, w_lgb, w_cat)\n\noof_blend = best_weights[0] * oof_nn + best_weights[1] * oof_lgb + best_weights[2] * oof_cat\ntest_blend = best_weights[0] * test_nn + best_weights[1] * test_lgb + best_weights[2] * test_cat\n\n# Conservative Class Multiplier Tuning (Bounded tightly to [0.85, 1.20] to prevent threshold overfitting)\nclass_mult = np.ones(6, dtype=np.float32)\ntuned_clean_f1 = best_ens_f1\nfor _ in range(3):\n    for c in range(6):\n        for m in np.linspace(0.85, 1.20, 36):\n            cand = class_mult.copy()\n            cand[c] = m\n            s = f1_score(y_clean, np.argmax(oof_blend[clean_mask] * cand[None, :], axis=1), average='macro')\n            if s > tuned_clean_f1:\n                tuned_clean_f1 = s\n                class_mult = cand\n\nprint(\"\\n========================================================\")\nprint(f\"Clean Anchor OOF Macro-F1 (HybridNetV4 Alone): {nn_clean_f1:.4f}\")\nprint(f\"Clean Anchor OOF Macro-F1 (Pruned-LGBM Alone): {lgb_clean_f1:.4f}\")\nprint(f\"Clean Anchor OOF Macro-F1 (Pruned-CatB Alone): {cat_clean_f1:.4f}\")\nprint(f\"Clean Anchor OOF Macro-F1 (Pruned Ensemble):   {best_ens_f1:.4f} | Weights (NN, LGB, CAT): {np.round(best_weights, 3)}\")\nprint(f\"Clean Anchor OOF Macro-F1 (Tuned Multipliers): {tuned_clean_f1:.4f} | Multipliers: {np.round(class_mult, 3)}\")\nprint(\"========================================================\")\nprint(classification_report(y_clean, np.argmax(oof_blend[clean_mask] * class_mult[None, :], axis=1), target_names=GESTURES))\n\n# Generate & Sanity-Check Final submission.csv\nfinal_preds = np.argmax(test_blend * class_mult[None, :], axis=1)\nfinal_labels = [INV_GESTURE_MAP[i] for i in final_preds]\n\nsample_sub_files = glob.glob(os.path.join(DATA_DIR, \"**\", \"sample_submission*.csv\"), recursive=True)\nif sample_sub_files:\n    sub = pd.read_csv(sample_sub_files[0])\n    id_col, target_col = sub.columns[0], sub.columns[1]\n    if len(sub) == len(final_labels) and len(set(test_ids)) == len(test_ids):\n        pred_map = dict(zip(test_ids, final_labels))\n        sub[target_col] = sub[id_col].map(pred_map).fillna(pd.Series(final_labels))\n    else:\n        sub[target_col] = final_labels\nelse:\n    sub = pd.DataFrame({'action_id': test_ids, 'gesture': final_labels})\n\nsub.to_csv(\"submission.csv\", index=False)\nprint(\"\\nSaved V4 submission.csv! Test Set Prediction Balance Check:\")\nprint(sub.iloc[:, 1].value_counts())","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}